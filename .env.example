# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aiagent
DB_PASS=AiAgent990
DB_NAME=ai_calls

# Asterisk ARI Configuration
ARI_HOST=127.0.0.1
ARI_PORT=8088
ARI_USER=ai_agent
ARI_PASS=ai_agent_secure_password_123
ARI_APP=aiagent

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Optional: OpenAI Proxy Configuration
# If your network requires a proxy to access OpenAI API, configure these settings.
# The system will automatically handle cases where the OpenAI client doesn't support
# the proxies parameter by falling back to environment variables.
#OPENAI_HTTP_PROXY=http://proxy.example.com:8080
#OPENAI_HTTPS_PROXY=http://proxy.example.com:8080

# TTS Configuration (Coqui TTS)
TTS_MODEL=tts_models/de/thorsten/tacotron2-DDC
TTS_LANGUAGE=de

# Whisper Configuration
WHISPER_MODEL=base
WHISPER_LANGUAGE=de

# Call Campaign Configuration
CAMPAIGN_NAME=Fund Recovery Lead Generation
OUTBOUND_CALLER_ID=+49123456789
MAX_CONCURRENT_CALLS=5
CALL_TIMEOUT=300

# Audio Configuration
AUDIO_SAMPLE_RATE=8000
AUDIO_CHANNELS=1

# Asterisk Directories
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/aiagent
ASTERISK_RECORDINGS_DIR=/var/spool/asterisk/recording
